[Unit]
Description=VM Sandbox daemon

[Service]
ExecStart=/usr/bin/vm-sandbox serve /etc/vm-sandbox/sandboxes.d /run/vm-sandbox
RuntimeDirectory=vm-sandbox
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN

[Install]
WantedBy=multi-user.target
